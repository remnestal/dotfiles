# Managed by chezmoi.
#
# id_git is not a default key name, so ssh only offers it for hosts named here.
# Both forges are listed unconditionally, matching the insteadOf rewrites in
# ~/.gitconfig.
#
# The overlay Include stays at the top: directives after a Host line belong to
# that block, and ssh takes the first value it finds, so the overlay overrides
# everything below.

Include ~/.local/share/dotfiles/ssh/*.conf

Host github.com gitlab.com
	IdentityFile ~/.ssh/id_git
	IdentitiesOnly yes
