# Managed by chezmoi. Run through the `gitkeys` wrapper (dot_zsh/40-gitkeys.zsh).
#
# Scope: the one SSH key git uses for push/pull and commit signing. Other keys
# are yours to make with ssh-keygen.
#
# Auth IS wrapped, unlike everything else here. Two reasons, both specific to
# gh: its default OAuth grant lacks admin:ssh_signing_key, so registering the
# signing key 404s; and its own remedy, `gh auth login`, offers to generate an
# SSH key -- a second key competing with the one this file owns. Following gh's
# advice is the wrong move, so its output is not left to stand as the error.
#
# Everything else is still unwrapped: duplicate keys, missing glab scopes and
# ssh-agent complaints say what they say.
#
# Forge selection is baked in at `chezmoi apply` from the init prompts, so
# there are no `command -v glab` checks at runtime.

version: "3"

tasks:
  status:
    desc: Report what is set up and what to run next
    silent: true
    # One shell block, not one command per check: task runs each cmds entry in
    # its own shell, so an early `exit` would only end that line's shell and
    # the rest would still run.
    #
    # The checks are the same expressions the tasks guard themselves with, so
    # the report cannot claim something the task disagrees with.
    cmds:
      - |
        if [ -f ~/.ssh/id_git ]; then
          echo "key    ~/.ssh/id_git"
        else
          echo "key    missing                       -> gitkeys setup"
        fi

        if ssh-add -l >/dev/null 2>&1; then
          echo "agent  unlocked"
        else
          echo "agent  no identities                 -> gitkeys login"
        fi
        {{- if .github }}

        if ! gh auth status >/dev/null 2>&1; then
          echo "gh     not logged in                 -> gitkeys auth"
        elif ! gh auth status 2>&1 | grep -q 'admin:ssh_signing_key'; then
          echo "gh     missing admin:ssh_signing_key -> gitkeys auth"
        else
          echo "gh     logged in"
        fi
        {{- end }}
        {{- if .gitlab }}

        if glab auth status >/dev/null 2>&1; then
          echo "glab   logged in"
        else
          echo "glab   not logged in                 -> gitkeys auth"
        fi
        {{- end }}

        if [ -f ~/.ssh/id_git.pub ] &&
           [ -f ~/.config/git/allowed_signers ] &&
           grep -qF "$(cat ~/.ssh/id_git.pub)" ~/.config/git/allowed_signers; then
          echo "trust  allowed_signers"
        else
          echo "trust  not trusted                   -> gitkeys trust"
        fi

        # Without a key there is nothing below to list, and asking the forge
        # about a key that does not exist yet is just noise.
        [ -f ~/.ssh/id_git ] || exit 0
        echo

        ssh-add -l || true
        {{- if .github }}
        # Tolerant: listing keys warns without admin:ssh_signing_key, and a
        # status command that fails because of that is worse than useless --
        # that is the exact thing you ran it to find out.
        gh ssh-key list || true
        {{- end }}
        {{- if .gitlab }}
        glab ssh-key list || true
        {{- end }}

  auth:
    desc: Log in to the configured forges with the scopes registration needs
{{- if or .github .gitlab }}
    # gh draws a TUI selector and opens a browser device flow.
    interactive: true
    status:
{{- if .github }}
      - gh auth status 2>&1 | grep -q 'admin:ssh_signing_key'
{{- end }}
{{- if .gitlab }}
      - glab auth status
{{- end }}
    cmds:
{{- if .github }}
      # refresh re-scopes an existing login and fails when there is none;
      # login is the cold path. gh keeps them separate, so we do too.
      - |
        if gh auth status >/dev/null 2>&1; then
          gh auth refresh -h github.com -s admin:public_key -s admin:ssh_signing_key
        else
          gh auth login -h github.com -s admin:public_key -s admin:ssh_signing_key
        fi
{{- end }}
{{- if .gitlab }}
      # No scope refresh: glab authenticates with a PAT, and a PAT cannot be
      # re-scoped after the fact. An under-scoped token is fixed by minting a
      # new one, which is glab's story to tell, not ours.
      - glab auth status >/dev/null 2>&1 || glab auth login
{{- end }}
{{- else }}
    cmds:
      - echo "no forge configured -- re-run chezmoi init --prompt"
{{- end }}

  keygen:
    desc: Generate the git SSH key (prompts for a passphrase)
    status:
      - test -f ~/.ssh/id_git
    cmds:
      - ssh-keygen -t ed25519 -C "git@$(hostname -s)" -f ~/.ssh/id_git

  login:
    desc: Unlock the key for 8 hours
    cmds:
      - ssh-add -t 8h ~/.ssh/id_git

  logout:
    desc: Drop the key from the agent now
    cmds:
      - ssh-add -d ~/.ssh/id_git

  trust:
    desc: Trust your own key so `git log --show-signature` can verify it
    # test -f first: on a fresh machine the file does not exist and a bare grep
    # would print an error before returning the "not done" we wanted anyway.
    status:
      - test -f ~/.config/git/allowed_signers && grep -qF "$(cat ~/.ssh/id_git.pub)" ~/.config/git/allowed_signers
    cmds:
      - mkdir -p ~/.config/git
      - echo "$(git config --get user.email) $(cat ~/.ssh/id_git.pub)" >> ~/.config/git/allowed_signers

  register:
    desc: Upload the public key to the configured forges
{{- if or .github .gitlab }}
    cmds:
{{- if .github }}
      - gh ssh-key add ~/.ssh/id_git.pub --type authentication --title "$(hostname -s)"
      - gh ssh-key add ~/.ssh/id_git.pub --type signing --title "$(hostname -s)"
{{- end }}
{{- if .gitlab }}
      - glab ssh-key add ~/.ssh/id_git.pub --title "$(hostname -s)"
{{- end }}
{{- else }}
    cmds:
      - echo "no forge configured -- re-run chezmoi init --prompt"
{{- end }}

  setup:
    desc: Generate, trust and register the key
    # Local steps first. trust is offline and cannot fail for network or auth
    # reasons, so putting it ahead of register means a forge problem leaves you
    # with a working local signing setup instead of an unverifiable one.
    cmds:
      - task: keygen
      - task: trust
      - task: auth
      - task: register
