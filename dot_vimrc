" Managed by chezmoi. Edit dot_vimrc in the source dir, not this file.

" Basic settings
set encoding=utf-8
set number
set relativenumber
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set smartindent
set cursorline
set hlsearch
set incsearch
set ignorecase
set smartcase

" Visual settings
syntax on
set background=dark

" Improve performance
set lazyredraw
set ttyfast

" Git commit messages
autocmd FileType gitcommit setlocal textwidth=72
autocmd FileType gitcommit setlocal spell spelllang=en_us
autocmd FileType gitcommit setlocal colorcolumn=73
autocmd BufEnter COMMIT_EDITMSG call cursor(1,1)

" Overlay: a private repo cloned by hand, absent on personal machines. Sourced
" last, in sorted order, so it can override anything above. glob() returns an
" empty list when the directory does not exist, so absence needs no guard.
for s:file in glob('~/.local/share/dotfiles/vim/*.vim', 0, 1)
  execute 'source' fnameescape(s:file)
endfor
