# Managed by chezmoi. Edit dot_gitconfig in the source dir, not this file.

[user]
	name = Albin Remnestål
	email = albin.remnestal+git@gmail.com
[core]
	editor = vim
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[commit]
	verbose = true
[diff]
	algorithm = patience
[merge]
	conflictstyle = zdiff3
	ff = no
[rerere]
	enabled = true
[branch]
	sort = -committerdate

# SSH commit signing. The key is generated by `gitkeys setup`, which also adds
# it to allowedSignersFile -- without that file, verification fails and %G?
# prints N even for commits you signed yourself.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[user]
	signingkey = ~/.ssh/id_git.pub
[commit]
	gpgsign = true

# insteadOf is multi-valued: the includes below can add rewrites, but cannot
# remove these two.
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/

# Layers, in increasing order of precedence. Both are optional -- git ignores
# an include whose path does not exist.
#
#   1. ~/.gitconfig.local  machine-local, holds the GPG signing key
#   2. the overlay         private repo, cloned by hand; owns its own
#                          includeIf rules for per-directory identity
#
# Later layers win per key, not per section: an overlay that sets only
# user.email leaves user.name from this file intact.

[include]
	path = ~/.gitconfig.local
[include]
	path = ~/.local/share/dotfiles/git/gitconfig
